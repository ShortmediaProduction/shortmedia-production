# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Der einzige Account, der sich einloggen darf
ALLOWED_EMAIL=

# ---------- Anthropic ----------
ANTHROPIC_API_KEY=
# Optional überschreiben
# SCORING_MODEL=claude-sonnet-5
# WRITING_MODEL=claude-opus-5-5

# ---------- Google (Gmail API) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail-Label, in das deine Job-Alerts per Filter sortiert werden
GMAIL_ALERT_LABEL=JobSwipe/Alerts

# ---------- App ----------
# Öffentliche URL ohne Schrägstrich am Ende (lokal http://localhost:3000)
APP_URL=https://jobswipe-xxxx.vercel.app
# Beliebiger langer Zufallswert, Vercel schickt ihn beim Cron mit
CRON_SECRET=

# ---------- Absender (bewusst nicht im Code, das Repo ist öffentlich) ----------
ABSENDER_NAME=Julian Lang
ABSENDER_ORT=Sissach
ABSENDER_TELEFON=
ABSENDER_EMAIL=
ABSENDER_WEB=www.julianlang.ch
# Zeilenumbrüche als \n
MAIL_SIGNATUR=Julian Lang - Video-/ Filmproduktion\nhttps://julianlang.ch/\n+41 ...

# ---------- Lokal ohne Supabase ausprobieren ----------
# DEMO_MODE=1
